@page "/console/listen-repeat/{Id:int}"
@page "/console/listen-repeat/create"
@rendermode InteractiveServer

@if (model != null)
{
    <div class="console-actions">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p>@errorMessage</p>
        }
        <div>
            @(IsEdit ? "Edit" : "Create") Listening
        </div>
        <div>
            <button type="button" class="button-first" @onclick="() => SaveAsync()">Save</button>
            <button type="button" class="button-second" @onclick="() => SaveAsync(true)">Save and Continue</button>
        </div>
    </div>

    <div class="console-form">
        <div class="form-box">
            <div>
                <select @bind="selectedVoice">
                    @foreach (string v in availableVoices)
                    {
                        <option value="@v">@v</option>
                    }
                </select>
            </div>
        </div>
        <div class="form-box">
            <div>
                <label>Name</label>
                <input type="text" placeholder="Name" @bind="model.Name" />
            </div>

            <div>
                <label>Difficulty</label>
                <select @bind="model.Difficulty">
                    <option value="@Difficulties.Easy">Easy</option>
                    <option value="@Difficulties.Medium">Medium</option>
                    <option value="@Difficulties.Hard">Hard</option>
                </select>
            </div>

            <div>
                <label>Display Order</label>
                <input type="number" @bind="model.DisplayOrder" />
            </div>

            <div>
                <label>Published</label>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="model.Published" />
                </label>
            </div>
        </div>

        <div class="form-box">
            @for (byte i = 0; i < 7; i++)
            {
                byte index = i;
                <div>
                    <label>Image</label>
                    <div class="media-selector">
                        @if (!string.IsNullOrWhiteSpace(model.ImageUrls[index]))
                        {
                            <img src="@model.ImageUrls[index]" alt="Preview" />
                            <button type="button" class="btn-remove" @onclick="@(() => model.ImageUrls[index] = string.Empty)">Remove</button>
                        }
                        <button type="button" class="btn-select" @onclick="@(() => showImagePickers[index] = !showImagePickers[index])">
                            @(showImagePickers[index] ? "Close Picker" : "Select Image")
                        </button>
                        @if (showImagePickers[index])
                        {
                            <FilePicker OnFileSelected="path => OnImageSelected(index, path)" />
                        }
                    </div>
                </div>
                <div>
                    <label>Sentence</label>
                    <input type="text" placeholder="Sentence" @bind="model.Sentences[index]" />
                    @if (!string.IsNullOrEmpty(model.AudioUrls[index]))
                    {
                        <audio controls src="@model.AudioUrls[index]"></audio>
                    }
                </div>
            }
        </div>
    </div>
}